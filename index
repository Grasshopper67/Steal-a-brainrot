<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Brainrot 3D — Collector Arena</title>
<style>
:root{--ink:#111;--accent:#7c3aed;--neon:#06b6d4;--bg:#0f172a}
*{box-sizing:border-box;user-select:none}
body{margin:0;overflow:hidden;background:var(--bg);color:#fff;font-family:system-ui,Segoe UI,sans-serif}
#world{position:fixed;inset:0}
canvas{display:block}
header{position:fixed;z-index:3;top:16px;left:16px;right:16px;display:flex;justify-content:space-between;align-items:center;pointer-events:none}
.hud-box{background:rgba(15,23,42,0.85);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.15);border-radius:14px;padding:12px 20px;box-shadow:0 8px 32px rgba(0,0,0,0.4);pointer-events:auto;display:flex;gap:20px;align-items:center}
.hud-item small{display:block;font-size:10px;text-transform:uppercase;color:#94a3b8;letter-spacing:1px}
.hud-item b{font-size:22px;color:var(--neon)}
#crosshair{position:fixed;z-index:2;top:50%;left:50%;width:8px;height:8px;background:#fff;border-radius:50%;transform:translate(-50%,-50%);pointer-events:none;box-shadow:0 0 8px rgba(255,255,255,0.8)}
#instructions{position:fixed;z-index:3;bottom:20px;left:50%;transform:translateX(-50%);background:rgba(15,23,42,0.9);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.15);border-radius:12px;padding:10px 20px;font-size:12px;text-align:center;color:#cbd5e1;pointer-events:none;box-shadow:0 4px 20px rgba(0,0,0,0.3)}
#toast{position:fixed;z-index:8;top:90px;left:50%;transform:translate(-50%,-10px);opacity:0;background:var(--accent);color:white;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:800;transition:.25s;pointer-events:none;box-shadow:0 6px 20px rgba(124,58,237,0.4)}
#toast.show{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>

<div id="world"></div>
<div id="crosshair"></div>

<header>
 <div class="hud-box">
  <div class="hud-item"><small>Score / Brainrot Items</small><b id="scoreVal">0</b></div>
  <div class="hud-item"><small>Speed</small><b id="speedVal">Normal</b></div>
 </div>
</header>

<div id="instructions"><b>Click anywhere</b> to lock mouse & look around · <b>WASD</b> to move · <b>Space</b> to jump · <b>Shift</b> to sprint</div>
<div id="toast"></div>

<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js"}}</script>
<script type="module">
import * as THREE from 'three';

let scene, camera, renderer;
let score = 0;
let collectibles = [];
let keys = {};
let velocity = new THREE.Vector3();
let isGrounded = false;
let moveSpeed = 7.5;
let sprintMultiplier = 1.6;

// Pointer lock controls variables
let isLocked = false;
let euler = new THREE.Euler(0, 0, 0, 'YXZ');
const PI_2 = Math.PI / 2;

function notify(text) {
 const t = document.querySelector('#toast');
 t.textContent = text;
 t.classList.add('show');
 clearTimeout(t._timer);
 t._timer = setTimeout(() => t.classList.remove('show'), 2000);
}

function init() {
 scene = new THREE.Scene();
 scene.background = new THREE.Color(0x090d16);
 scene.fog = new THREE.FogExp2(0x090d16, 0.015);

 camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 100);
 camera.position.set(0, 1.8, 10);

 renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
 renderer.setSize(window.innerWidth, window.innerHeight);
 renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
 renderer.shadowMap.enabled = true;
 renderer.shadowMap.type = THREE.PCFSoftShadowMap;
 document.querySelector('#world').appendChild(renderer.domElement);

 // Lights
 const ambient = new THREE.AmbientLight(0x38bdf8, 0.6);
 scene.add(ambient);

 const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
 dirLight.position.set(20, 35, 20);
 dirLight.castShadow = true;
 dirLight.shadow.mapSize.set(2048, 2048);
 dirLight.shadow.bias = -0.0005;
 scene.add(dirLight);

 // Colored Neon Arena Lights
 const p1 = new THREE.PointLight(0x7c3aed, 3, 30);
 p1.position.set(-10, 5, -10);
 scene.add(p1);

 const p2 = new THREE.PointLight(0x06b6d4, 3, 30);
 p2.position.set(10, 5, 10);
 scene.add(p2);

 // Environment / Floor
 const floorGeo = new THREE.PlaneGeometry(120, 120, 32, 32);
 const floorMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.8, metalness: 0.2 });
 const floor = new THREE.Mesh(floorGeo, floorMat);
 floor.rotation.x = -Math.PI / 2;
 floor.receiveShadow = true;
 scene.add(floor);

 // Grid lines on floor
 const grid = new THREE.GridHelper(120, 40, 0x06b6d4, 0x334155);
 grid.position.y = 0.01;
 scene.add(grid);

 // Neon Obstacles / Buildings
 const boxMat = new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.5, metalness: 0.5 });
 for (let i = 0; i < 24; i++) {
  const w = 3 + Math.random() * 5;
  const h = 4 + Math.random() * 12;
  const d = 3 + Math.random() * 5;
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), boxMat);
  
  let x = (Math.random() - 0.5) * 90;
  let z = (Math.random() - 0.5) * 90;
  // Keep center clear
  if (Math.abs(x) < 12 && Math.abs(z) < 12) x += 20;

  mesh.position.set(x, h / 2, z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  scene.add(mesh);
 }

 // Spawn Collectibles
 for (let i = 0; i < 20; i++) {
  spawnCollectible();
 }

 // Event Listeners
 window.addEventListener('resize', onWindowResize);
 document.addEventListener('pointerlockchange', () => {
  isLocked = document.pointerLockElement === renderer.domElement;
 });
 document.addEventListener('click', () => {
  if (!isLocked) renderer.domElement.requestPointerLock();
 });
 document.addEventListener('mousemove', onMouseMove);
 window.addEventListener('keydown', e => keys[e.code] = true);
 window.addEventListener('keyup', e => keys[e.code] = false);

 notify('🎮 Arena Loaded! Collect glowing items!');
}

function spawnCollectible() {
 const geo = new THREE.OctahedronGeometry(0.7);
 const mat = new THREE.MeshStandardMaterial({ 
  color: Math.random() > 0.5 ? 0x06b6d4 : 0x7c3aed, 
  emissive: Math.random() > 0.5 ? 0x06b6d4 : 0x7c3aed,
  emissiveIntensity: 0.8,
  roughness: 0.1 
 });
 const item = new THREE.Mesh(geo, mat);
 
 item.position.set(
  (Math.random() - 0.5) * 95,
  1 + Math.random() * 3,
  (Math.random() - 0.5) * 95
 );
 item.castShadow = true;
 scene.add(item);
 collectibles.push(item);
}

function onMouseMove(e) {
 if (!isLocked) return;
 const movementX = e.movementX || e.mozMovementX || e.webkitMovementX || 0;
 const movementY = e.movementY || e.mozMovementY || e.webkitMovementY || 0;

 euler.y -= movementX * 0.002;
 euler.x -= movementY * 0.002;
 euler.x = Math.max(-PI_2, Math.min(PI_2, euler.x));
 camera.quaternion.setFromEuler(euler);
}

function onWindowResize() {
 camera.aspect = window.innerWidth / window.innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth, innerHeight);
}

let clock = new THREE.Clock();

function animate() {
 requestAnimationFrame(animate);
 const dt = Math.min(clock.getDelta(), 0.1);
 const t = clock.elapsedTime;

 if (isLocked) {
  const sprint = !!(keys.ShiftLeft || keys.ShiftRight);
  const currentSpeed = moveSpeed * (sprint ? sprintMultiplier : 1);
  document.querySelector('#speedVal').textContent = sprint ? 'Sprinting ⚡' : 'Normal';

  const forward = (keys.KeyW ? 1 : 0) - (keys.KeyS ? 1 : 0);
  const side = (keys.KeyD ? 1 : 0) - (keys.KeyA ? 1 : 0);

  const dir = new THREE.Vector3();
  camera.getWorldDirection(dir);
  dir.y = 0;
  dir.normalize();

  const sideDir = new THREE.Vector3(-dir.z, 0, dir.x);

  const moveDir = new THREE.Vector3();
  moveDir.addScaledVector(dir, forward);
  moveDir.addScaledVector(sideDir, side);
  if (moveDir.lengthSq() > 0) moveDir.normalize();

  velocity.x = moveDir.x * currentSpeed;
  velocity.z = moveDir.z * currentSpeed;

  // Jump logic
  if (isGrounded && keys.Space) {
   velocity.y = 7.5;
   isGrounded = false;
  }

  // Apply gravity
  velocity.y -= 22 * dt;

  camera.position.x += velocity.x * dt;
  camera.position.y += velocity.y * dt;
  camera.position.z += velocity.z * dt;

  // Floor collision
  if (camera.position.y < 1.8) {
   camera.position.y = 1.8;
   velocity.y = 0;
   isGrounded = true;
  }

  // Map boundary clamp
  camera.position.x = THREE.MathUtils.clamp(camera.position.x, -55, 55);
  camera.position.z = THREE.MathUtils.clamp(camera.position.z, -55, 55);
 }

 // Animate & check collection of items
 for (let i = collectibles.length - 1; i >= 0; i--) {
  const item = collectibles[i];
  item.rotation.y += dt * 2;
  item.position.y += Math.sin(t * 3 + i) * 0.004;

  if (camera.position.distanceTo(item.position) < 2.2) {
   scene.remove(item);
   collectibles.splice(i, 1);
   score += 1;
   document.querySelector('#scoreVal').textContent = score;
   notify(`✨ Collected item! Total: ${score}`);
   spawnCollectible();
  }
 }

 renderer.render(scene, camera);
}

init();
animate();
</script>

</body>
</html>
